# OKYANUSYA — Avustralya + Okyanusya (Geofabrik australia-oceania-latest)
# PBF: ~1.5 GB | Tile: ~8-15 GB | Build: 2-8 saat
# ═══════════════════════════════════════════════════════════════

VALHALLA_PORT=8002
VALHALLA_DATA_DIR=/mnt/volume_ams3_1782933520272/valhalla-data/oceania

TILE_URLS=https://download.geofabrik.de/australia-oceania-latest.osm.pbf

SERVER_THREADS=2
VALHALLA_MEMORY_LIMIT=14g
VALHALLA_SHM_SIZE=512m
INSTALL_WAIT_HOURS=12

USE_TILES_IGNORE_PBF=False
FORCE_REBUILD=False
BUILD_ELEVATION=False
BUILD_ADMINS=True
BUILD_TIME_ZONES=True
BUILD_TRANSIT=False
BUILD_TAR=True
