# ═══════════════════════════════════════════════════════════════
# ASYA — Tüm kıta (Geofabrik asia-latest)
# PBF: ~14 GB | Tile: ~60-90 GB | Build: 12-48 saat
# ═══════════════════════════════════════════════════════════════

VALHALLA_PORT=8002
VALHALLA_DATA_DIR=/mnt/volume_ams3_1782933520272/valhalla-data/asia

TILE_URLS=https://download.geofabrik.de/asia-latest.osm.pbf

SERVER_THREADS=2
VALHALLA_MEMORY_LIMIT=14g
VALHALLA_SHM_SIZE=512m
INSTALL_WAIT_HOURS=48

USE_TILES_IGNORE_PBF=False
FORCE_REBUILD=False
BUILD_ELEVATION=False
BUILD_ADMINS=True
BUILD_TIME_ZONES=True
BUILD_TRANSIT=False
BUILD_TAR=True
