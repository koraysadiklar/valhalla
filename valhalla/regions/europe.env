# Avrupa — Almanya örneği (tek ülke, planet değil)
VALHALLA_PORT=8002
TILE_URLS=https://download.geofabrik.de/europe/germany-latest.osm.pbf
SERVER_THREADS=4
USE_TILES_IGNORE_PBF=True
FORCE_REBUILD=False
BUILD_ELEVATION=False
BUILD_ADMINS=True
BUILD_TIME_ZONES=True
BUILD_TRANSIT=False
BUILD_TAR=True
VALHALLA_MEMORY_LIMIT=16G
