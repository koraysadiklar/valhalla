# Türkiye — tam ülke haritası (~607MB PBF, ~8GB RAM önerilir)
# Not: Geofabrik yolu /europe/turkey (eski /asia/turkey artık geçersiz)
VALHALLA_PORT=8002
TILE_URLS=https://download.geofabrik.de/europe/turkey-latest.osm.pbf
SERVER_THREADS=1
USE_TILES_IGNORE_PBF=False
FORCE_REBUILD=False
BUILD_ELEVATION=False
BUILD_ADMINS=True
BUILD_TIME_ZONES=True
BUILD_TRANSIT=False
BUILD_TAR=True
VALHALLA_MEMORY_LIMIT=8G
