# Türkiye — tam ülke haritası (~500MB PBF, ~8GB RAM önerilir)
VALHALLA_PORT=8002
TILE_URLS=https://download.geofabrik.de/asia/turkey-latest.osm.pbf
SERVER_THREADS=4
USE_TILES_IGNORE_PBF=True
FORCE_REBUILD=False
BUILD_ELEVATION=False
BUILD_ADMINS=True
BUILD_TIME_ZONES=True
BUILD_TRANSIT=False
BUILD_TAR=True
VALHALLA_MEMORY_LIMIT=8G
