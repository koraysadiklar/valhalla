# ═══════════════════════════════════════════════════════════════
# DÜNYA — Planet + Elevation
# PBF: ~80 GB | Tiles: ~500 GB | Elevation: ~150-300 GB
# Disk: volume-valhalla | RAM: 16 GB + 16 GB swap
# CPU: 4 thread | Build: uzun sürer (elevation + swap ile)
# ═══════════════════════════════════════════════════════════════

VALHALLA_PORT=8002
VALHALLA_DATA_DIR=/mnt/volume-valhalla/valhalla-data/world

TILE_URLS=https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf

# 4 CPU
SERVER_THREADS=4

# Container bellek: 14 GB RAM + 16 GB swap hakkı (toplam 30g)
# OS için ~2 GB boş bırakılır
VALHALLA_MEMORY_LIMIT=14g
VALHALLA_MEMORY_SWAP=30g
VALHALLA_SHM_SIZE=1g

# Host swap — volume üzerinde 16 GB
SETUP_SWAP=True
SWAP_SIZE=16G
SWAP_FILE=/mnt/volume-valhalla/swapfile

# Bekleme: 21 gün
INSTALL_WAIT_HOURS=504

USE_TILES_IGNORE_PBF=False
FORCE_REBUILD=False

# Elevation açık
BUILD_ELEVATION=True
BUILD_ADMINS=True
BUILD_TIME_ZONES=True
BUILD_TRANSIT=False
BUILD_TAR=True
