# ═══════════════════════════════════════════════════════════════
# DÜNYA — Planet + Elevation
# PBF: ~80 GB | Tiles: ~500 GB | Elevation: ~150-300 GB
# Disk: 1.7 TB volume | RAM: 32 GB + 32 GB swap
# CPU: 8 thread | Build: 7-21 gün (elevation ile)
# ═══════════════════════════════════════════════════════════════

VALHALLA_PORT=8002
VALHALLA_DATA_DIR=/mnt/volume_ams3_1782933520272/valhalla-data/world

TILE_URLS=https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf

# 8 CPU — tam kullanım
SERVER_THREADS=8

# Container bellek: 30 GB RAM + 32 GB swap hakkı (toplam 62g)
VALHALLA_MEMORY_LIMIT=30g
VALHALLA_MEMORY_SWAP=62g
VALHALLA_SHM_SIZE=2g

# Host swap (kurulum öncesi make swap ile oluşturulur)
SETUP_SWAP=True
SWAP_SIZE=32G
SWAP_FILE=/mnt/volume_ams3_1782933520272/swapfile

# Bekleme: 21 gün
INSTALL_WAIT_HOURS=504

USE_TILES_IGNORE_PBF=False
FORCE_REBUILD=False

# Elevation açık — ek disk ve süre gerektirir
BUILD_ELEVATION=True
BUILD_ADMINS=True
BUILD_TIME_ZONES=True
BUILD_TRANSIT=False
BUILD_TAR=True
