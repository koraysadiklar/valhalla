# ═══════════════════════════════════════════════════════════════
# DÜNYA — Planet (OpenStreetMap tam küre)
# PBF: ~80 GB | Tile: ~400+ GB | Build: 3-7 gün
# ⚠️  16 GB RAM ile build ÇOK ZOR — minimum 64 GB RAM önerilir
# ⚠️  750 GB volume tek başına yetmeyebilir
# Büyütme sonrası: RAM 64GB+, Disk 1TB+, CPU 8+
# ═══════════════════════════════════════════════════════════════

VALHALLA_PORT=8002
VALHALLA_DATA_DIR=/mnt/volume_ams3_1782933520272/valhalla-data/world

# Geofabrik planet mirror (planet.openstreetmap.org yönlendirmeli)
TILE_URLS=https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf

SERVER_THREADS=1
VALHALLA_MEMORY_LIMIT=15g
VALHALLA_SHM_SIZE=1g
INSTALL_WAIT_HOURS=168

USE_TILES_IGNORE_PBF=False
FORCE_REBUILD=False
BUILD_ELEVATION=True
BUILD_ADMINS=True
BUILD_TIME_ZONES=True
BUILD_TRANSIT=False
BUILD_TAR=True
