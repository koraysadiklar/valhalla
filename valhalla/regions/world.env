# Andorra — minimal test (~2MB, CI/deneme için)
VALHALLA_PORT=8002
TILE_URLS=https://download.geofabrik.de/europe/andorra-latest.osm.pbf
SERVER_THREADS=4
USE_TILES_IGNORE_PBF=True
FORCE_REBUILD=False
BUILD_ELEVATION=True
BUILD_ADMINS=True
BUILD_TIME_ZONES=True
BUILD_TRANSIT=False
BUILD_TAR=True
VALHALLA_MEMORY_LIMIT=2G
