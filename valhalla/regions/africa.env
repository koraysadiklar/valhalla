VALHALLA_PORT=8002
VALHALLA_DATA_DIR=/mnt/volume_ams3_1782933520272/valhalla-data/africa

TILE_URLS=https://download.geofabrik.de/africa-latest.osm.pbf

SERVER_THREADS=2
