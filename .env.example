# Valhalla HTTP port (host)
VALHALLA_PORT=8002

# OSM PBF indirme URL'leri (boşlukla ayırarak birden fazla verebilirsiniz)
# Boş bırakırsanız valhalla/custom_files/ içindeki *.osm.pbf dosyaları kullanılır
TILE_URLS=https://download.geofabrik.de/europe/turkey-latest.osm.pbf

# Küçük test bölgesi (~2MB, hızlı kurulum):
# TILE_URLS=https://download.geofabrik.de/europe/andorra-latest.osm.pbf
# veya: make region REGION=test

# Tile üretimi ve servis thread sayısı (RAM yetersizse düşürün)
SERVER_THREADS=4

# Mevcut tile varsa PBF'yi yoksay (True önerilir, restart sonrası hızlı açılış)
USE_TILES_IGNORE_PBF=True

# Tile'ları sıfırdan yeniden üret
FORCE_REBUILD=False

# Yükseklik verisi (disk/RAM tüketir, True yaparsanız build süresi uzar)
BUILD_ELEVATION=True

# Admin ve timezone veritabanları (zaman bağımlı rota için gerekli)
BUILD_ADMINS=True
BUILD_TIME_ZONES=True

# GTFS toplu taşıma (gtfs_feeds volume gerekir)
BUILD_TRANSIT=False

# Tile tarball oluştur (önerilir, servis açılışını hızlandırır)
BUILD_TAR=True

# Docker bellek limiti (Türkiye haritası için en az 8G önerilir)
VALHALLA_MEMORY_LIMIT=15G
